{
    "manifest_version": 3,
    "name": "No Scroll",
    "version": "1.0",
    "description": "A chrome extension that blocks infinite scroll mechanic across few major websites.",
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.youtube.com/shorts/*",
                "https://www.instagram.com/reels/*"

            ],
            "js": ["content.js"]
        }
    ],
    "icons": {
        "16": "icon.png",
        "32": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    }
}