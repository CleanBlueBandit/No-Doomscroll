{
    "manifest_version": 3,
    "name": "No Scroll",
    "version": "1.4.0",
    "description": "A chrome extension that blocks infinite scroll mechanic across few major websites.",
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ],
    "icons": {
        "16": "icon.png",
        "32": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "selectors.json"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}